"""
Test suites to run.

Diagnostics are off by default to avoid verbose log and goroutine dump overhead.
Set the module's diagnostics option to enable verbose test output and dev-engine
stacks at 15 and 25 minutes, for example:
`dagger api call test-split --diagnostics test-workspaces`.
"""
type TestSplit {
  """
  Enable verbose test output and engine goroutine dumps at 15 and 25 minutes
  """
  diagnostics: Boolean! = false

  let dumpAfter: [String!]! = if (self.diagnostics) { ["15m", "25m"] } else { [] }

  """
  The remote cache service's URL, for the test engines to join its remote
  cache. The test engines join only when this, cloudUrl and cloudToken are
  all set.
  """
  remoteCacheUrl: Secret = null

  """
  The Dagger Cloud URL the test engines export their cache events to
  """
  cloudUrl: Secret = null

  """
  An engine token for the remote cache and Dagger Cloud
  """
  cloudToken: Secret = null

  """
  Workspace
  """
  let ws: Workspace!

  # The core/integration suites each check runs, as go test -run or -skip
  # patterns. testShardCoverage checks that together they run every suite
  # exactly once.

  # Exact exclusions preserve similarly named suites and leave new suites in
  # the catch-all test-base until they are explicitly assigned elsewhere.
  let baseSkip: [String!]! = [
    "^TestCLI$",
    "^TestCachePersistence$",
    "^TestCall$",
    "^TestContainer$",
    "^TestDaggerCMD$",
    "^TestDockerfile$",
    "^TestElixir$",
    "^TestEngine$",
    "^TestGo$",
    "^TestInterface$",
    "^TestJava$",
    "^TestLLM$",
    "^TestLocalCache$",
    "^TestModule$",
    "^TestModuleConfig$",
    "^TestModuleDefinitionSuite$",
    "^TestModuleLoading$",
    "^TestPHP$",
    "^TestProvision$",
    "^TestPython$",
    "^TestShell$",
    "^TestTelemetry$",
    "^TestTypescript$",
    "^TestWorkspace$",
    "^TestWorkspaceAPI$",
    "^TestWorkspaceCompat$",
    "^TestWorkspaceLegacyDefaultPath$",
    "^TestWorkspaceMigration$",
    "^TestWorkspaceModules$",
    "^TestWorkspaceSelection$",
    "^TestAgentRestore$",
    "^TestAgents$",
    "^TestArtifacts$",
    "^TestCache$",
    "^TestCallIDRebuild$",
    "^TestCommandHints$",
    "^TestDaggerUpVerifyHarness$",
    "^TestDang$",
    "^TestDirectory$",
    "^TestEnvFile$",
    "^TestGPU$",
    "^TestGenerators$",
    "^TestGit$",
    "^TestHTTP$",
    "^TestHost$",
    "^TestLegacy$",
    "^TestListen$",
    "^TestLocalDir$",
    "^TestLockfile$",
    "^TestRemoteCacheTransferSuite$",
    "^TestRuntimeCodegen$",
    "^TestSecretProvider$",
    "^TestSequential$",
    "^TestType$",
  ]

  let baseExtraRun: [String!]! = [
    "^TestAgentRestore$",
    "^TestAgents$",
    "^TestArtifacts$",
    "^TestCache$",
    "^TestCallIDRebuild$",
    "^TestCommandHints$",
    "^TestDaggerUpVerifyHarness$",
    "^TestDang$",
    "^TestDirectory$",
    "^TestEnvFile$",
    "^TestGPU$",
    "^TestGenerators$",
    "^TestGit$",
    "^TestHTTP$",
    "^TestHost$",
    "^TestLegacy$",
    "^TestListen$",
    "^TestLocalDir$",
    "^TestLockfile$",
    "^TestRemoteCacheTransferSuite$",
    "^TestRuntimeCodegen$",
    "^TestSecretProvider$",
    "^TestSequential$",
    "^TestType$",
  ]

  let provisionRun: [String!]! = ["TestProvision"]
  let telemetryRun: [String!]! = ["^TestTelemetry$"]
  let callAndShellRun: [String!]! = ["^TestCall$", "^TestShell$"]
  let cliEngineRun: [String!]! = ["^TestCLI$", "^TestEngine$"]
  let cachePersistenceRun: [String!]! = ["TestCachePersistence"]
  let localCacheRun: [String!]! = ["TestLocalCache"]
  let containerRun: [String!]! = ["TestContainer", "TestDockerfile"]
  let interfaceRun: [String!]! = ["TestInterface"]
  let llmRun: [String!]! = ["TestLLM"]
  let moduleRuntimesRun: [String!]! = ["TestGo", "TestPython", "TestTypescript", "TestElixir", "TestPHP", "TestJava"]
  let modulesRun: [String!]! = ["^TestModule$", "^TestModuleConfig$", "^TestModuleLoading$"]
  let moduleDefinitionsRun: [String!]! = ["^TestModuleDefinitionSuite$"]
  let workspacesRun: [String!]! = [
    "^TestWorkspace$",
    "^TestWorkspaceAPI$",
    "^TestWorkspaceCompat$",
    "^TestWorkspaceLegacyDefaultPath$",
    "^TestWorkspaceMigration$",
    "^TestWorkspaceModules$",
    "^TestWorkspaceSelection$",
  ]

  """
  Lower-level API for running specific tests
  """
  pub testSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    timeout: String,
    parallel: Int,
    """
    Run the privileged eBPF tests (Linux 6.15 or newer)
    """
    ebpf: Boolean,
  ): Void {
    engineDev(ws: self.ws).test(parallel: parallel, timeout: timeout, race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, ebpf: ebpf, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter, remoteCacheUrl: self.remoteCacheUrl, cloudUrl: self.cloudUrl, cloudToken: self.cloudToken)
  }

  let testCliEngineSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    """
    Keep the test engine off the remote cache, for the suites that test the
    engine's own cache
    """
    noRemoteCache: Boolean! = false,
  ): Void {
    let dev = engineDev(ws: self.ws)
      .withEngineConfig("worker.oci", [
        "minFreeSpace = \"30%\"",
        "maxUsedSpace = \"50%\"",
      ].join("\n"))
    if (noRemoteCache) {
      dev.test(race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
    } else {
      dev.test(race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter, remoteCacheUrl: self.remoteCacheUrl, cloudUrl: self.cloudUrl, cloudToken: self.cloudToken)
    }
  }

  let testSkip(
    skip: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    parallel: Int,
  ): Void {
    engineDev(ws: self.ws).test(parallel: parallel, race: race, skip: skip.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter, remoteCacheUrl: self.remoteCacheUrl, cloudUrl: self.cloudUrl, cloudToken: self.cloudToken)
  }

  """
  Base integration tests not assigned to another shard
  """
  pub testBase: Void @check {
    testSkip(skip: self.baseSkip, race: true, parallel: 16)
  }

  """
  Base integration tests assigned to the additional shard
  """
  pub testBaseExtra: Void @check {
    testSpecific(run: self.baseExtraRun, race: true, parallel: 16)
  }

  """
  Package patterns covered by the package-test shard
  """
  pub packagePatterns: String! {
    # Match the source tree used by engine-dev tests: workspace-only tools
    # excluded from that tree must not become explicit package arguments.
    go(ws: self.ws, source: engineDev(ws: self.ws).source, race: true, cgo: true).env.withExec([
      "go", "list", "-race", "-f",
      "{{if ne .ImportPath \"github.com/dagger/dagger/core/integration\"}}{{.ImportPath}}{{end}}",
      "./...",
    ]).stdout
  }

  """
  Package tests outside core/integration, with the engine fixtures preserved
  """
  pub testPackages: Void @check {
    testSkip(
      # Preserve the old base exclusions: telemetry and CLI package suites
      # already have dedicated checks, while similarly named tests still run.
      skip: [
        "^TestCLI$",
        "^TestCachePersistence$",
        "^TestCall$",
        "^TestContainer$",
        "^TestDaggerCMD$",
        "^TestDockerfile$",
        "^TestElixir$",
        "^TestEngine$",
        "^TestGo$",
        "^TestInterface$",
        "^TestJava$",
        "^TestLLM$",
        "^TestLocalCache$",
        "^TestModule$",
        "^TestModuleConfig$",
        "^TestModuleDefinitionSuite$",
        "^TestModuleLoading$",
        "^TestPHP$",
        "^TestProvision$",
        "^TestPython$",
        "^TestShell$",
        "^TestTelemetry$",
        "^TestTypescript$",
        "^TestWorkspace$",
        "^TestWorkspaceAPI$",
        "^TestWorkspaceCompat$",
        "^TestWorkspaceLegacyDefaultPath$",
        "^TestWorkspaceMigration$",
        "^TestWorkspaceModules$",
        "^TestWorkspaceSelection$",
      ],
      pkg: self.packagePatterns,
      race: true,
      parallel: 4,
    )
  }

  """
  Test Provision
  """
  pub testProvision: Void @check {
    testSpecific(self.provisionRun)
  }

  """
  Test Telemetry
  """
  pub testTelemetry: Void @check {
    # Rendering goldens require their warmup cache to survive session teardown.
    engineDev(ws: self.ws)
      .withEngineConfig("worker.oci", "gc = false")
      .test(run: "^TestTelemetry$", pkg: "./dagql/idtui", testVerbose: self.diagnostics, dumpAfter: self.dumpAfter, remoteCacheUrl: self.remoteCacheUrl, cloudUrl: self.cloudUrl, cloudToken: self.cloudToken)
    testSpecific(self.telemetryRun)

    null
  }

  """
  Test Call and Shell
  """
  pub testCallAndShell: Void @check {
    testSpecific(self.callAndShellRun)
    testSpecific(["^TestDaggerCMD$"], pkg: "./internal/cmd/dagger")

    null
  }

  """
  Test CLI Engine
  """
  pub testCliEngine: Void @check {
    testCliEngineSpecific(self.cliEngineRun)
  }

  """
  Test cache persistence
  """
  pub testCachePersistence: Void @check {
    testCliEngineSpecific(self.cachePersistenceRun, noRemoteCache: true)
  }

  """
  Test local cache
  """
  pub testLocalCache: Void @check {
    testCliEngineSpecific(self.localCacheRun, noRemoteCache: true)
  }

  """
  Test Container
  """
  pub testContainer: Void @check {
    testSpecific(self.containerRun)
  }

  """
  Test Interface
  """
  pub testInterface: Void @check {
    testSpecific(self.interfaceRun)
  }

  """
  Test LLM
  """
  pub testLlm: Void @check {
    testSpecific(self.llmRun)
  }

  """
  Test Module Runtimes
  """
  pub testModuleRuntimes: Void @check {
    testSpecific(self.moduleRuntimesRun)
  }

  """
  Test Modules
  """
  pub testModules: Void @check {
    testSpecific(self.modulesRun)
  }

  """
  Test module definition caching with the race detector.
  This suite starts multiple engines and runs separately from the base shard.
  """
  pub testModuleDefinitions: Void @check {
    testSpecific(self.moduleDefinitionsRun, race: true)
  }

  """
  Test Workspaces
  """
  pub testWorkspaces: Void @check {
    testSpecific(self.workspacesRun)
  }

  """
  Check that the checks run every core/integration suite exactly once
  """
  pub testShardCoverage: Void @check {
    let env = go(ws: self.ws, source: engineDev(ws: self.ws).source).env
    let suites = env.withExec(["go", "test", "-list", ".", "./core/integration"]).stdout
    let args = ["go", "run", ".", "suites.txt"]
    args += ["test-base", "", self.baseSkip.join("|")]
    args += ["test-base-extra", self.baseExtraRun.join("|"), ""]
    args += ["test-provision", self.provisionRun.join("|"), ""]
    args += ["test-telemetry", self.telemetryRun.join("|"), ""]
    args += ["test-call-and-shell", self.callAndShellRun.join("|"), ""]
    args += ["test-cli-engine", self.cliEngineRun.join("|"), ""]
    args += ["test-cache-persistence", self.cachePersistenceRun.join("|"), ""]
    args += ["test-local-cache", self.localCacheRun.join("|"), ""]
    args += ["test-container", self.containerRun.join("|"), ""]
    args += ["test-interface", self.interfaceRun.join("|"), ""]
    args += ["test-llm", self.llmRun.join("|"), ""]
    args += ["test-module-runtimes", self.moduleRuntimesRun.join("|"), ""]
    args += ["test-modules", self.modulesRun.join("|"), ""]
    args += ["test-module-definitions", self.moduleDefinitionsRun.join("|"), ""]
    args += ["test-workspaces", self.workspacesRun.join("|"), ""]
    env
      .withWorkdir("/shard-coverage")
      .withNewFile("go.mod", "module shardcoverage\n\ngo 1.26\n")
      .withFile("main.go", currentModule.source.file("shard-coverage/main.go"))
      .withNewFile("suites.txt", suites)
      .withExec(args)
      .sync

    null
  }

  """
  Test eBPF network accounting of engine subprocesses and executor workloads
  in a privileged test container
  """
  pub testEbpf: Void @check {
    testSpecific(["^TestCommandAccounting$", "^TestWorkloadAccounting$"], pkg: "./engine/ebpf/nettracer", ebpf: true)
  }
}

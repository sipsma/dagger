+
+// precompiled is the filter Precompile prepared for InitSeccomp.
+var precompiled *compiledFilter
+
+type compiledFilter struct {
+	config     *configs.Seccomp
+	prog       []unix.SockFilter
+	flags      uint
+	noNewPrivs bool
+}
+
+// Precompile prepares the filter for config, from cacheDir if a previous
+// container compiled the same one, so that InitSeccomp only has to load it.
+// It must run before the container's rootfs is set up, while cacheDir is
+// still reachable. On error, InitSeccomp compiles the filter as usual.
+func Precompile(config *configs.Seccomp, cacheDir string) error {
+	key, err := cacheKey(config)
+	if err != nil {
+		return err
+	}
+	path := filepath.Join(cacheDir, key)
+	if b, err := os.ReadFile(path); err == nil {
+		if c, ok := decodeFilter(b); ok {
+			c.config = config
+			precompiled = c
+			return nil
+		}
+	}
+	filter, err := buildFilter(config)
+	if err != nil {
+		return err
+	}
+	prog, flags, noNewPrivs, err := patchbpf.Compile(config, filter)
+	if err != nil {
+		return err
+	}
+	precompiled = &compiledFilter{config: config, prog: prog, flags: flags, noNewPrivs: noNewPrivs}
+	if err := os.MkdirAll(cacheDir, 0o700); err != nil {
+		return nil
+	}
+	tmp := fmt.Sprintf("%s.%d.tmp", path, os.Getpid())
+	if err := os.WriteFile(tmp, encodeFilter(precompiled), 0o600); err != nil {
+		return nil
+	}
+	_ = os.Rename(tmp, path)
+	return nil
+}
+
+// cacheKey identifies a compiled filter: the config, the libseccomp it was
+// compiled with, and this format.
+func cacheKey(config *configs.Seccomp) (string, error) {
+	b, err := json.Marshal(config)
+	if err != nil {
+		return "", err
+	}
+	major, minor, micro := libseccomp.GetLibraryVersion()
+	api, _ := libseccomp.GetAPI()
+	h := sha256.New()
+	fmt.Fprintf(h, "runc-seccomp-cache-v1 libseccomp %d.%d.%d api %d\n", major, minor, micro, api)
+	h.Write(b)
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+
+func encodeFilter(c *compiledFilter) []byte {
+	b := binary.LittleEndian.AppendUint64(nil, uint64(c.flags))
+	if c.noNewPrivs {
+		b = append(b, 1)
+	} else {
+		b = append(b, 0)
+	}
+	for _, ins := range c.prog {
+		b = binary.LittleEndian.AppendUint16(b, ins.Code)
+		b = append(b, ins.Jt, ins.Jf)
+		b = binary.LittleEndian.AppendUint32(b, ins.K)
+	}
+	return b
+}
+
+func decodeFilter(b []byte) (*compiledFilter, bool) {
+	if len(b) < 9 || (len(b)-9)%8 != 0 || len(b) == 9 {
+		return nil, false
+	}
+	c := &compiledFilter{flags: uint(binary.LittleEndian.Uint64(b)), noNewPrivs: b[8] == 1}
+	for p := b[9:]; len(p) > 0; p = p[8:] {
+		c.prog = append(c.prog, unix.SockFilter{
+			Code: binary.LittleEndian.Uint16(p),
+			Jt:   p[2],
+			Jf:   p[3],
+			K:    binary.LittleEndian.Uint32(p[4:]),
+		})
+	}
+	return c, true
+}

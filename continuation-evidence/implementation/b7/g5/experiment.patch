diff --git a/engine/snapshots/testutil/bind_experiment.go b/engine/snapshots/testutil/bind_experiment.go
new file mode 100644
index 0000000000..f961b9a93d
--- /dev/null
+++ b/engine/snapshots/testutil/bind_experiment.go
@@ -0,0 +1,128 @@
+package testutil
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/diff"
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/containerd/v2/pkg/archive"
+	"github.com/containerd/containerd/v2/pkg/archive/compression"
+	"github.com/containerd/containerd/v2/pkg/labels"
+	"github.com/containerd/errdefs"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// bindSource returns the directory behind a native snapshot's single bind
+// mount, so a test can read or write it without a mount system call.
+func bindSource(mounts []mount.Mount) (string, func(), error) {
+	if len(mounts) == 0 {
+		dir, err := os.MkdirTemp("", "snapshot-test-empty")
+		return dir, func() { os.RemoveAll(dir) }, err
+	}
+	if len(mounts) != 1 || (mounts[0].Type != "bind" && mounts[0].Type != "rbind") {
+		return "", nil, fmt.Errorf("test store expects one native bind mount, got %+v", mounts)
+	}
+	return mounts[0].Source, func() {}, nil
+}
+
+type bindApplier struct{ store content.Store }
+
+func (a bindApplier) Apply(ctx context.Context, desc ocispecs.Descriptor, mounts []mount.Mount, opts ...diff.ApplyOpt) (ocispecs.Descriptor, error) {
+	var config diff.ApplyConfig
+	for _, opt := range opts {
+		if err := opt(ctx, desc, &config); err != nil {
+			return ocispecs.Descriptor{}, err
+		}
+	}
+	root, release, err := bindSource(mounts)
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	defer release()
+	ra, err := a.store.ReaderAt(ctx, desc)
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	defer ra.Close()
+	processor := diff.NewProcessorChain(desc.MediaType, content.NewReader(ra))
+	for processor.MediaType() != ocispecs.MediaTypeImageLayer {
+		if processor, err = diff.GetProcessor(ctx, processor, config.ProcessorPayloads); err != nil {
+			return ocispecs.Descriptor{}, err
+		}
+	}
+	defer processor.Close()
+	digester := digest.Canonical.Digester()
+	size, err := archive.Apply(ctx, root, io.TeeReader(processor, digester.Hash()))
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	extra, err := io.Copy(io.Discard, io.TeeReader(processor, digester.Hash()))
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	return ocispecs.Descriptor{MediaType: ocispecs.MediaTypeImageLayer, Size: size + extra, Digest: digester.Digest()}, nil
+}
+
+type bindDiffer struct{ store content.Store }
+
+func (d bindDiffer) Compare(ctx context.Context, lower, upper []mount.Mount, opts ...diff.Opt) (ocispecs.Descriptor, error) {
+	var config diff.Config
+	for _, opt := range opts {
+		if err := opt(&config); err != nil {
+			return ocispecs.Descriptor{}, err
+		}
+	}
+	lowerRoot, releaseLower, err := bindSource(lower)
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	defer releaseLower()
+	upperRoot, releaseUpper, err := bindSource(upper)
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	defer releaseUpper()
+	writer, err := d.store.Writer(ctx, content.WithRef(config.Reference), content.WithDescriptor(ocispecs.Descriptor{MediaType: config.MediaType}))
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	defer writer.Close()
+	if err := writer.Truncate(0); err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	stored := map[string]string{}
+	if config.MediaType == ocispecs.MediaTypeImageLayer {
+		err = archive.WriteDiff(ctx, writer, lowerRoot, upperRoot)
+	} else {
+		var compressed io.WriteCloser
+		if config.Compressor != nil {
+			compressed, err = config.Compressor(writer, config.MediaType)
+		} else {
+			compressed, err = compression.CompressStream(writer, compression.Gzip)
+		}
+		if err != nil {
+			return ocispecs.Descriptor{}, err
+		}
+		digester := digest.SHA256.Digester()
+		err = archive.WriteDiff(ctx, io.MultiWriter(compressed, digester.Hash()), lowerRoot, upperRoot)
+		compressed.Close()
+		stored[labels.LabelUncompressed] = digester.Digest().String()
+	}
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	dgst := writer.Digest()
+	if err := writer.Commit(ctx, 0, dgst, content.WithLabels(stored)); err != nil && !errdefs.IsAlreadyExists(err) {
+		return ocispecs.Descriptor{}, err
+	}
+	info, err := d.store.Info(ctx, dgst)
+	if err != nil {
+		return ocispecs.Descriptor{}, err
+	}

+	if !s.started[par] {
+		// Anchor par first (recursively), unless its own parent is mid-replay.
+		if pp := s.p.parent[par]; pp >= 0 && !s.inFlight[pp] {
+			s.spawnTo(pp, par)
+		}
+		if !s.started[par] {
+			s.fallbackAnchor(par)
+		}
+	}
+

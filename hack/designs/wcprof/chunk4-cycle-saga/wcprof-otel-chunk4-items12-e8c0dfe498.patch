 	}
@@ -310,16 +309,96 @@ func TestZeroDurChildAtJoinWaitEnd(t *testing.T) {
 	if sim.CycleWarnings != 0 {
 		t.Fatalf("CycleWarnings = %d, want 0", sim.CycleWarnings)
